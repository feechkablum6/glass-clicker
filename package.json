{
  "name": "glass-clicker",
  "version": "1.0.0",
  "description": "Автокликер для Windows со стеклянным интерфейсом: горячая клавиша, скорость и режим работы",
  "main": "main.js",
  "author": "AKASHI",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "build": "electron-builder --win"
  },
  "type": "commonjs",
  "dependencies": {
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.akashi.glass-clicker",
    "productName": "Glass Clicker",
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Klicker-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Klicker-Portable-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-overlay.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png"
    ]
  }
}
